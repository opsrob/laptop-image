[Unit]
Description=Set laptop-image default power profile (first boot only)
After=tuned-ppd.service
Wants=tuned-ppd.service
ConditionPathExists=!/var/lib/laptop-image/power-profile-set

[Service]
Type=oneshot
ExecStart=/usr/libexec/laptop-image-set-power-profile.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
