[Unit]
Description=Install laptop-image snap packages (first boot only)
Wants=snapd.seeded.service network-online.target
After=snapd.seeded.service network-online.target
ConditionPathExists=!/var/lib/laptop-image/snaps-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/laptop-image-install-snaps.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
